# ============================================================================
# NexOra-Database-key-Gen — Database Key Generator & License Management System
# Secure Keys. Smarter Database Management.
# Copy to .env and replace every placeholder. Never commit .env.
# ============================================================================

# production | staging | development
APP_ENV=production

# Global timezone is stored in the database (system_settings ->
# nexora.display_timezone), not in this file. Default: UTC. Change it in
# Classic Platform Settings -> Global timezone. Stored timestamps remain UTC.
# Migration 012 seeds UTC only when the setting is absent.

# ============================================================================
# Initial administrator (server-side only)
# ============================================================================
# The plaintext password is never stored in this file. Generate an Argon2id
# hash on a trusted machine and paste only the hash here:
#
#   python -m backend.cli hash-password --email admin@example.com
#
# The account is created once, on first start. If it already exists it is left
# untouched, even if the hash below changes later. Use the explicit command
# below to change a password (never edit an existing account automatically):
#
#   python -m backend.cli set-password --email admin@example.com
#
# The Argon2id value contains '$'. python-dotenv reads it literally; do not
# `source .env` in a shell (the shell would expand the '$' segments).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_PASSWORD_HASH
# Applied only when the account is first created: owner or admin.
ADMIN_ROLE=owner

# Flask secret key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never expose this value to frontend code or commit it to git.
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Supabase PostgreSQL connection string (server-side only).
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the session pooler (port 5432) or the transaction pooler (port 6543).
# `sslmode=require` is verified TLS in this application; use verify-full for
# full hostname verification semantics.
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_DB_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# CA bundle for database providers that use a private CA. Supabase's pooler
# serves the `Supabase Root 2021 CA`, which is not in the system trust store.
# Download it from Database -> SSL Configuration (prod-ca-2021.crt). Relative
# paths resolve from the project root; the bundle supplements the system roots.
# Leave empty for providers whose CA is publicly trusted.
DATABASE_SSLROOTCERT=certs/prod-ca-2021.crt

# Server-side pepper mixed into every key hash (HMAC-SHA256).
# Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates lookup of every existing key, so store it in a
# secret manager and keep a backup.
KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Admin session lifetime in hours (1-720).
SESSION_TTL_HOURS=8

# Secure cookies require HTTPS. Keep true in production.
# Set false only for local HTTP development.
COOKIE_SECURE=true

# Set true only when the app runs behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false

# Per-IP API rate limiting (single process). Keep enabled in production.
RATE_LIMIT_ENABLED=true

# ============================================================================
# Automatic expiration cleanup scheduler
# ============================================================================
# The application process starts one embedded, lock-protected scheduler worker
# by default. It expires and then hard-deletes due keys and projects, prunes
# expired sessions, and retries webhook deliveries. No cron entry is required.
#
# Set SCHEDULER_EMBEDDED=0 only when you deploy the separate worker described
# in docs/SCHEDULER.md (cron, systemd, or Windows Task Scheduler). The same
# PostgreSQL advisory lock serializes any overlapping workers.
SCHEDULER_EMBEDDED=1
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_BATCH_SIZE=100
# Safe label stored with each run. Defaults to "cli" when empty.
SCHEDULER_WORKER_ID=web
#
# Deletion policy lives in the database, not this file:
#   nexora.expired_key_retention_days  days an expired key is kept (0 = at expiry)
#   nexora.auto_delete_days            optional project retention policy
# Per-project/key expiry is set by the "expires_at" field, which is also the
# automatic deletion instant. "Never" records without an explicit deletion
# timestamp are never deleted.

# Upper bound for one bulk generation request (1-2000).
MAX_BULK_KEYS=500

# Connection pool size (1-50).
DB_POOL_MAX=10

# Optional log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ============================================================================
# SMS Reader One-Time Key Management (isolated console)
# ============================================================================
# Start the SMS surface with:
#   python run_sms.py
# or in production:
#   waitress-serve --listen=127.0.0.1:5100 --call sms_reader:create_sms_app
#
# It shares the administrator, Argon2id, session, CSRF, audit and rate-limit
# primitives above, but registers only SMS routes and uses its own session
# audience (sms_reader) and cookie name.
SMS_HOST=127.0.0.1
SMS_PORT=5100
SMS_SESSION_COOKIE_NAME=nexora_sms_session

# Dedicated pepper for SMS activation keys and device credentials.
# Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, the SMS surface falls back to KEY_PEPPER. Use a separate value in
# production so an activation key digest cannot collide with a license digest.
# Rotating it invalidates lookup of every existing SMS key and device token.
SMS_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# One-time key batch limits and reader heartbeat cadence.
SMS_MAX_BULK_KEYS=200
SMS_HEARTBEAT_INTERVAL_SECONDS=300
SMS_HEARTBEAT_LOG_SECONDS=3600

# ============================================================================
# NexOra Phase 1 — Supabase Project Integration (server-side only)
# ============================================================================
# SUPABASE_URL   : Your Supabase project URL.
#                  Format: https://<project-ref>.supabase.co
#                  Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
#                  Validated at start-up: must start with https:// and contain .supabase.co
#                  Leave empty if you are using DATABASE_URL only (without Supabase REST).
#
# SUPABASE_SERVICE_ROLE_KEY : The service-role JWT for your Supabase project.
#                  Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
#                  CAUTION: This key bypasses Row Level Security. NEVER expose it to the
#                  browser or commit it to version control. It is excluded from all logs.
#
# Both values must be set together, or both left empty.
# They are never written to logs and never sent to the browser.
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY


# Local developer launcher (run.py)
# Set to 0 to stop run.py from opening the login page in your browser.
NEXORA_OPEN_BROWSER=1
